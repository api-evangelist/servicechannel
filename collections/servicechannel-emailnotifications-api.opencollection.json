            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/users/current/locations/:locationId/subscribe",
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Numeric Id of the Location to perform action with."
              }
            ]
          },
          "docs": "Subscribe to Email Notification.\r\n            <br /><br />Available for subscriber usage."
        },
        {
          "info": {
            "name": "List existing email subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/users/current/locations/:locationId/email",
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a list of email subscriptions"
        },
        {
          "info": {
            "name": "Unsubscribe from Email Notifications",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/current/unsubscribe"
          },
          "docs": "Unsubscribe from Email Notifications.\r\n            <br /><br />Available for subscriber usage."
        },
        {
          "info": {
            "name": "Unsubscribe from Email Notifications",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/current/locations/:locationId/unsubscribe",
            "params": [
              {
                "name": "locationId",
                "value": "",
