                "name": "areaId",
                "value": "",
                "type": "query"
              },
              {
                "name": "trade",
                "value": "",
                "type": "query"
              },
              {
                "name": "problemType",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Providers For Subscriber User by Trade",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/getbytrade",
            "params": [
              {
                "name": "trade",
                "value": "",
                "type": "query"
              }
            ]
