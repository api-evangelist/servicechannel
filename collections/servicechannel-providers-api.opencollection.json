        {
          "info": {
            "name": "POSTv3_providers_{providerId}_feedback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/providers/:providerId/feedback",
            "params": [
              {
                "name": "providerId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Set isDoNotDispatch value for providers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/providers/updateDispatchSetting"
          },
          "docs": "Set isDoNotDispatch value for providers"
        },
        {
          "info": {
            "name": "Allows one to get information whether the SDIMobileInt flag is enabled.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/providers/IsSdiMobileEnabled",
            "params": [
              {
                "name": "subscriberId",
                "value": "",
                "type": "query",
                "description": "Subscriber id"
              },
              {
                "name": "locationId",
                "value": "",
                "type": "query",
                "description": "Location id"
              }
            ]
          },
          "docs": "True - if the FF is enabled for a provider and subscriber or for a provider and location.\r\n            Otherwise it returns false."
        },
        {
