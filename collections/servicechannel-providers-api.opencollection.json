        {
          "info": {
            "name": "Providers For Subscriber User by Trade",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/getbytradeid",
            "params": [
              {
                "name": "tradeId",
