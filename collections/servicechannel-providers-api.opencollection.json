      "items": [
        {
          "info": {
            "name": "Providers_ProviderData",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/providers/ProviderData"
          }
        },
        {
          "info": {
            "name": "Retrieve the list of subscribers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/subscribers",
            "params": [
              {
                "name": "providerId",
                "value": "",
                "type": "query",
                "description": "Unique numeric identifier of the provider."
              }
            ]
          },
          "docs": "Returns the names and IDs of subscribers whose private network the provider is in."
        },
        {
          "info": {
            "name": "GETv3_api_providers_info_{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/providers/info/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "Delete provider of subscriber",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/providers/RemoveProviderSubscriberLink"
          },
          "docs": "Delete provider of subscriber."
